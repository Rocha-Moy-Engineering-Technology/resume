{
  "name": "contractor-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "timeout 60s vitest run",
    "test:watch": "vitest",
    "test:coverage": "timeout 60s vitest run --coverage",
    "test:integration": "timeout 120s vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "validate": "npm run format && npm run check && npm run lint && npm run test:coverage && npm run build",
    "validate:all": "npm run format:check && npm run check && npm run lint && npm run test:coverage && npm run test:integration && npm run test:e2e && npm run build"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.0",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "svelte": "^5.57.3",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12",
    "wrangler": "4.160.0"
  }
}
